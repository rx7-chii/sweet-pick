# SWEET PICK — Supabase（Phase 2 / 本番デプロイ）
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=eyJhbGci...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# 画像: 本番では Supabase Storage 等の URL をブラウザが CDN から直接取得（推奨・デフォルト）
# false にすると Next.js サーバー経由の画像最適化を使う（Vercel 等で SSL が正常な場合）
# NEXT_PUBLIC_IMAGE_DIRECT_FETCH=true

# MVP ローカル開発: モックデータ + public/images/sweets/ を使用（DB 接続不要）
